<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>user page</h1>
    <form action="/api/user" method="POST">
        <input type="text"name="name" placeholder="Enter name">
        <input type="number"name="age" placeholder="Enter age">
         <button type="submit">submit</button>
    </form>
    <hr>
    <ul>
    <% userData.forEach((ele)=>{ %>
        <li> <%= ele.name %> <%=ele.age %>
            <form action="http://localhost:3000/api/user/<%=ele.id %>?_method=DELETE"METHOD="POST"><button type="submit"><a href=/delete></a>Delete</button>
            </form>
            <form>
                <button><a href="/page/editpage/<%= ele.id %>/">Edit</a></button>
            </form>
        </li>
        <% }) %>
    </ul>
    
</body>
</html>
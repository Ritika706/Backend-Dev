<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1> edit page</h1>
    <form action="/api/user/<%= user.id %>?_method=PUT" method="POST">
        <input type="text" name="name" placeholder="change name" value="<%= user.name %>">
        <input type="number" name="age" placeholder="change age" value="<%= user.age %>">
        <button type="submit">submit</button>
        <a href="/api/user">back</a>
    </form>
</body>
</html>